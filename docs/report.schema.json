{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AmitSinghOM/rag-evaluation-framework/blob/main/docs/report.schema.json",
  "title": "rageval evaluation report, schema_version 1",
  "description": "Written by `rageval run`. Field meanings: docs/REPORT-SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rageval_version",
    "created_at",
    "dataset",
    "run",
    "metrics",
    "per_query",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "rageval_version": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qrels", "n_queries", "n_judged_relevant"],
      "properties": {
        "qrels": { "$ref": "#/$defs/fileRef" },
        "n_queries": { "type": "integer", "minimum": 1 },
        "n_judged_relevant": { "type": "integer", "minimum": 0 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "n_queries_in_run", "duplicate_ids"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "n_queries_in_run": { "type": "integer", "minimum": 0 },
        "duplicate_ids": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/metricName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mean", "ci95", "n", "bootstrap"],
        "properties": {
          "mean": { "type": "number" },
          "ci95": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "n": { "type": "integer", "minimum": 1 },
          "bootstrap": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resamples", "seed"],
            "properties": {
              "resamples": { "type": "integer", "minimum": 1 },
              "seed": { "type": "integer" }
            }
          }
        }
      }
    },
    "per_query": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/metricName" },
        "additionalProperties": { "type": "number" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "metricName": { "type": "string", "pattern": "^(ndcg|recall|precision|mrr)@[1-9][0-9]*$|^mrr$" },
    "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
